// Synthetic Fix: module 'main' of the made-up title (build id below)
@nsobid-0123456789ABCDEF0123456789ABCDEF
@flag offset_shift 0x100

// Skip intro check [docs]
@enabled
00000040 00008052        // mov w0, #0
00000100 C0035FD6        // ret

// Rename the title string [docs]
@enabled
00001010 "Patched"

// Debug flag on [docs]
@disabled
00001800 01

// Address beyond the module (shows a MISS in the apply report)
@enabled
00005000 00000000
@stop
