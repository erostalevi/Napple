# TLS terminator for the Napple game servers. Certificates: automatic (Let's Encrypt / ZeroSSL) for a public name, Caddy's internal CA for localhost.
# NAPPLE_DOMAIN: pretend.napple.lat on AWS, localhost for a local Docker run.
{
	admin 127.0.0.1:2019
}

{$NAPPLE_DOMAIN:pretend.napple.lat} {
	encode zstd gzip
	header -Server

	# napple-room's plain-HTTP status API (/room/healthz, /room/rooms), prefix stripped.
	handle_path /room/* {
		reverse_proxy room:8081
	}

	# napple-account (/account/v1/*, prefix kept) and napple-social (/social/v1/*, prefix kept; reverse_proxy forwards the WebSocket upgrade of
	# /social/v1/stream as is). social answers /social/v1/healthz itself; account has /healthz at its root, exposed as /account/healthz.
	# Service-to-service routes (napple-social and napple-online reach them over the compose network with a shared token) are never public.
	@internal path /account/v1/internal/* /social/v1/internal/*
	handle @internal {
		respond 404
	}
	handle_path /account/healthz {
		rewrite * /healthz
		reverse_proxy account:8082
	}
	handle /account/v1/* {
		reverse_proxy account:8082
	}
	handle /social/v1/* {
		reverse_proxy social:8083 {
			stream_timeout 24h
			stream_close_delay 5s
		}
	}

	# Everything else: napple-online (/healthz included) and the NEX game server (PRUDP Lite over a WebSocket upgrade,
	# forwarded by reverse_proxy as is; X-Forwarded-For carries the client address).
	handle {
		reverse_proxy online:8080
	}

	log
}
